    const totalQuestions = 36;

    const answerKey = {
      1: "B", 2: "A", 3: "C", 4: "A", 5: "B", 6: "C", 7: "B", 8: "B",
      9: "A", 10: "C", 11: "B", 12: "C", 13: "A", 14: "C", 15: "B", 16: "A",
      17: "A", 18: "C", 19: "B", 20: "A", 21: "C", 22: "B", 23: "A", 24: "C",
      25: "B", 26: "A", 27: "C", 28: "B", 29: "A", 30: "C", 31: "B", 32: "A",
      33: "C", 34: "B", 35: "A", 36: "C"
    };

    const funnyRight = [
      "You got it buddy, you're right!",
      "You must be a smart one, you are right!",
      "Look at you go! That's right!",
      "Boom! Correct answer, superstar.",
      "You nailed it. Big brain energy!",
      "Correct! You came ready today."
    ];

    const funnyWrong = [
      "Somebody needs to study for the test next time, sorry you're wrong.",
      "You must have been in the bathroom during that part, sorry you're wrong.",
      "Nope! That answer took a wrong turn.",
      "Wrong answer, but I respect the confidence.",
      "Close... not really. Sorry, you're wrong.",
      "That was brave, but wrong."
    ];

    function randomLine(arr) {
      return arr[Math.floor(Math.random() * arr.length)];
    }

    function submitAllAnswers() {
      let totalRight = 0;

      for (let i = 1; i <= totalQuestions; i++) {
        const selected = document.querySelector(`input[name="answer${i}"]:checked`);
        const result = document.getElementById(`result${i}`);

        if (!selected) {
          result.textContent = "No answer selected.";
          continue;
        }

        if (selected.value === answerKey[i]) {
          result.textContent = randomLine(funnyRight);
          totalRight++;
        } else {
          result.textContent = randomLine(funnyWrong);
        }
      }

      document.getElementById("finalScore").textContent =
        `Congrats you have ${totalRight} out of ${totalQuestions} correct!`;
    }
  </script>
